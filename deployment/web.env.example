# Canonical Web-role environment. No source-ingestion credentials belong here.
NARROWCTI_STATE_DIR=/app/state
NARROWCTI_RUNTIME_DB=/app/state/runtime.db
NARROWCTI_QUARANTINE_REPOSITORY=/app/state/quarantine.jsonl
NARROWCTI_RELEASE_AUDIT_FILE=/app/state/audit/releases.jsonl
NARROWCTI_REVIEW_API_CREDENTIALS_FILE=/run/secrets/narrowcti-review-api-credentials.json
NARROWCTI_REVIEW_API_DOCS_ENABLED=false
NARROWCTI_REVIEW_API_ALLOW_EXPORT=true
NARROWCTI_REVIEW_API_IDENTITY_NAME=NarrowCTI Gateway
NARROWCTI_REVIEW_API_ALLOWED_HOSTS=127.0.0.1,localhost
NARROWCTI_REVIEW_API_MAX_BODY_BYTES=16384
NARROWCTI_REVIEW_EXPORT_TIMEOUT_SECONDS=30
